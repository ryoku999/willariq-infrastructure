generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AppRole {
  ADMIN
  SUPERVISOR
  OPERATOR
  CITIZEN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum AreaMemberRole {
  MANAGER
  OPERATOR
}

enum MunicipalAreaStatus {
  ACTIVE
  INACTIVE
}

enum IncidentSource {
  MOBILE_APP
  WEB_APP
  CHATBOT
  PHONE
  WHATSAPP
  IN_PERSON
  OTHER
}

enum IncidentType {
  INFRASTRUCTURE
  SECURITY
  HEALTH
  ENVIRONMENT
  NOISE
  TRAFFIC
  PUBLIC_SERVICES
  SOCIAL
  EMERGENCY
  OTHER
}

enum IncidentCategory {
  FALLEN_UTILITY_POLE
  WATER_OUTAGE
  POWER_OUTAGE
  STREET_FIGHT
  THEFT
  TRAFFIC_ACCIDENT
  GARBAGE_ACCUMULATION
  POTHOLE
  FLOOD
  FIRE
  EXCESSIVE_NOISE
  VANDALISM
  LOOSE_ANIMALS
  AMBULANCE_REQUIRED
  POLICE_REQUIRED
  OTHER
}

enum IncidentStatus {
  RECEIVED
  AI_ANALYSIS
  IN_REVIEW
  ACCEPTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
  CLOSED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REASSIGNED
}

enum UrgencyLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Sentiment {
  NEUTRAL
  WORRIED
  PANIC
  ANGRY
  URGENT
}

enum EvidenceType {
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
  OTHER
}

enum HistoryActorType {
  USER
  AI
  SYSTEM
}

enum AiProvider {
  CEREBRAS
  GROQ
  OPENROUTER
}

enum AiCapability {
  INCIDENT_CLASSIFICATION
  CHATBOT
  EMBEDDING
}

enum AiJobType {
  INCIDENT_ANALYSIS
  CHAT_RESPONSE
  EMBEDDING_DOCUMENT
  EMBEDDING_QUERY
}

enum AiJobTrigger {
  AUTOMATIC
  MANUAL
  RETRY
}

enum AiJobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum AiAttemptStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  TIMEOUT
  RATE_LIMITED
  INVALID_RESPONSE
}

enum ChatStatus {
  ACTIVE
  CLOSED
}

enum ChatRole {
  SYSTEM
  USER
  ASSISTANT
}

enum KnowledgeDocumentStatus {
  DRAFT
  PROCESSING
  READY
  ERROR
  ARCHIVED
}

enum KnowledgeSourceType {
  MANUAL
  PDF
  WEB
  MUNICIPAL_REGULATION
  FAQ
  PROCEDURE
  OTHER
}

enum NotificationType {
  INCIDENT_CREATED
  INCIDENT_STATUS_CHANGED
  INCIDENT_ASSIGNED
  INCIDENT_RESOLVED
  INCIDENT_REJECTED
  AI_REVIEW_REQUIRED
  GENERAL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

// ============================================================
// AUTH PROPIA EN NESTJS
// Registro actual: firstName + dni + phone + password obligatorios.
// email y lastName son opcionales.
// Passwords: guardar SOLO hash (Argon2id recomendado).
// Refresh tokens: guardar SOLO hash, nunca el token en claro.
// ============================================================

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  firstName       String     @db.VarChar(80)
  lastName        String?    @db.VarChar(120)
  dni             String     @unique @db.VarChar(8)
  phone           String     @unique @db.VarChar(20)
  email           String?    @unique @db.VarChar(160)
  passwordHash    String     @db.VarChar(255)

  // Preparado para el futuro: si el usuario agrega email,
  // luego podrás implementar verificación sin rediseñar la tabla.
  emailVerifiedAt DateTime?

  avatarObjectKey String?    @db.Text
  role            AppRole    @default(CITIZEN)
  status          UserStatus @default(ACTIVE)
  failedLoginAttempts Int    @default(0)
  lockedUntil     DateTime?
  lastLoginAt     DateTime?
  passwordChangedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sessions             AuthSession[]
  passwordResetTokens  PasswordResetToken[]
  incidents            Incident[]             @relation("IncidentReporter")
  incidentHistories    IncidentHistory[]
  assignments          IncidentAssignment[]   @relation("AssignmentOperator")
  areaMemberships      MunicipalAreaMember[]
  requestedAiJobs      AiJob[]                @relation("AiJobRequester")
  chatSessions         ChatSession[]
  notifications        Notification[]
  devices              UserDevice[]
  auditLogs            AuditLog[]
  uploadedEvidence     IncidentEvidence[]     @relation("EvidenceUploader")
  reviewedIncidents    Incident[]             @relation("IncidentReviewer")
  createdKnowledgeDocs KnowledgeDocument[]    @relation("KnowledgeCreatedBy")
  publishedKnowledgeDocs KnowledgeDocument[]  @relation("KnowledgePublishedBy")

  @@index([role, status])
  @@index([email, status])
  @@index([createdAt])
  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid(7)) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique @db.VarChar(255)
  familyId         String    @db.Uuid
  userAgent        String?   @db.Text
  ipAddress        String?   @db.VarChar(64)
  expiresAt        DateTime
  lastUsedAt       DateTime?
  revokedAt        DateTime?
  revokeReason     String?   @db.VarChar(160)
  createdAt        DateTime  @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("auth_sessions")
}


model PasswordResetToken {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model UserDevice {
  id         String         @id @default(uuid(7)) @db.Uuid
  userId     String         @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   DevicePlatform
  pushToken  String         @unique @db.Text
  deviceId   String?        @db.VarChar(200)
  active     Boolean        @default(true)
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([userId, active])
  @@map("user_devices")
}

model MunicipalArea {
  id          String              @id @default(uuid(7)) @db.Uuid
  code        String              @unique @db.VarChar(30)
  name        String              @unique @db.VarChar(120)
  description String?             @db.Text
  phone       String?             @db.VarChar(30)
  email       String?             @db.VarChar(160)
  status      MunicipalAreaStatus @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  members     MunicipalAreaMember[]
  assignments IncidentAssignment[]

  @@index([status])
  @@map("municipal_areas")
}

model MunicipalAreaMember {
  id        String         @id @default(uuid(7)) @db.Uuid
  areaId    String         @db.Uuid
  area      MunicipalArea  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  userId    String         @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AreaMemberRole @default(OPERATOR)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([areaId, userId])
  @@index([userId, active])
  @@index([areaId, active])
  @@map("municipal_area_members")
}

model Incident {
  id              String          @id @default(uuid(7)) @db.Uuid
  trackingCode    String          @unique @db.VarChar(30)
  reporterId      String          @db.Uuid
  reporter        User            @relation("IncidentReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  clientRequestId String          @db.VarChar(100)
  source          IncidentSource  @default(MOBILE_APP)

  originalMessage     String       @db.Text
  improvedDescription String?      @db.Text
  recommendedAction   String?      @db.Text
  type                IncidentType?
  category            IncidentCategory?
  urgency             UrgencyLevel?
  sentiment           Sentiment?
  keywords            String[]     @default([])
  aiConfidence        Decimal?     @db.Decimal(5, 4)
  requiresSupervision Boolean      @default(false)

  // PostGIS
  location         Unsupported("geography(Point,4326)")?
  latitude         Decimal         @db.Decimal(10, 7)
  longitude        Decimal         @db.Decimal(10, 7)
  address          String?         @db.VarChar(300)
  addressReference String?         @db.Text

  status        IncidentStatus @default(RECEIVED)
  reviewedById String?        @db.Uuid
  reviewedBy   User?          @relation("IncidentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  reviewedAt  DateTime?
  acceptedAt  DateTime?
  assignedAt  DateTime?
  startedAt   DateTime?
  resolvedAt  DateTime?
  rejectedAt  DateTime?
  closedAt    DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities     IncidentEntity[]
  evidence     IncidentEvidence[]
  histories    IncidentHistory[]
  assignments  IncidentAssignment[]
  aiJobs       AiJob[]
  chatSessions ChatSession[]

  @@unique([reporterId, clientRequestId])
  @@index([reporterId, createdAt])
  @@index([status, createdAt])
  @@index([urgency, status])
  @@index([category, status])
  @@index([type, status])
  @@index([requiresSupervision, status])
  @@map("incidents")
}

model IncidentEntity {
  id              String   @id @default(uuid(7)) @db.Uuid
  incidentId      String   @db.Uuid
  incident        Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  type            String   @db.VarChar(40)
  value           String   @db.VarChar(300)
  normalizedValue String?  @db.VarChar(300)
  confidence      Decimal? @db.Decimal(5, 4)
  createdAt       DateTime @default(now())

  @@index([incidentId, type])
  @@map("incident_entities")
}

model IncidentEvidence {
  id           String        @id @default(uuid(7)) @db.Uuid
  incidentId   String        @db.Uuid
  incident     Incident      @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedById String?       @db.Uuid
  uploadedBy   User?         @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  type       EvidenceType
  bucket     String       @db.VarChar(100)
  objectKey  String       @db.Text
  mimeType   String       @db.VarChar(120)
  fileName   String?      @db.VarChar(255)
  sizeBytes  BigInt?
  checksum   String?      @db.VarChar(128)
  width      Int?
  height     Int?
  durationMs Int?
  capturedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_evidence")
}

model IncidentHistory {
  id             String           @id @default(uuid(7)) @db.Uuid
  incidentId     String           @db.Uuid
  incident       Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  userId         String?          @db.Uuid
  user           User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  actorType      HistoryActorType @default(USER)
  previousStatus IncidentStatus?
  newStatus      IncidentStatus
  comment        String?          @db.Text
  metadata       Json?
  createdAt      DateTime         @default(now())

  @@index([incidentId, createdAt])
  @@index([newStatus, createdAt])
  @@map("incident_history")
}

model IncidentAssignment {
  id          String           @id @default(uuid(7)) @db.Uuid
  incidentId  String           @db.Uuid
  incident    Incident         @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  areaId      String           @db.Uuid
  area        MunicipalArea    @relation(fields: [areaId], references: [id], onDelete: Restrict)
  operatorId  String?          @db.Uuid
  operator    User?            @relation("AssignmentOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  status      AssignmentStatus @default(ASSIGNED)
  note        String?          @db.Text
  assignedAt  DateTime         @default(now())
  acceptedAt  DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([incidentId, assignedAt])
  @@index([areaId, status])
  @@index([operatorId, status])
  @@map("incident_assignments")
}

model ChatSession {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  incidentId String?    @db.Uuid
  incident   Incident?  @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  status     ChatStatus @default(ACTIVE)
  title      String?    @db.VarChar(180)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  closedAt   DateTime?

  messages ChatMessage[]

  @@index([userId, createdAt])
  @@index([incidentId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid(7)) @db.Uuid
  sessionId String      @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String      @db.Text
  metadata  Json?
  createdAt DateTime    @default(now())

  aiJobs AiJob[]

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model PromptVersion {
  id             String       @id @default(uuid(7)) @db.Uuid
  name           String       @db.VarChar(120)
  version        Int
  capability     AiCapability
  systemPrompt   String       @db.Text
  responseSchema Json?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  jobs AiJob[]

  @@unique([name, version])
  @@index([capability, active])
  @@map("prompt_versions")
}

model AiRoute {
  id         String       @id @default(uuid(7)) @db.Uuid
  capability AiCapability
  provider   AiProvider
  model      String       @db.VarChar(180)
  priority   Int
  enabled    Boolean      @default(true)
  timeoutMs  Int          @default(30000)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([capability, priority])
  @@index([capability, enabled, priority])
  @@map("ai_routes")
}

model AiJob {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          AiJobType
  trigger       AiJobTrigger @default(AUTOMATIC)
  status        AiJobStatus  @default(PENDING)

  incidentId    String?      @db.Uuid
  incident      Incident?    @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  chatMessageId String?      @db.Uuid
  chatMessage   ChatMessage? @relation(fields: [chatMessageId], references: [id], onDelete: Cascade)

  promptVersionId String?        @db.Uuid
  promptVersion   PromptVersion? @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  requestedById String? @db.Uuid
  requestedBy   User?   @relation("AiJobRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  retryOfJobId String? @db.Uuid
  retryOfJob   AiJob?  @relation("AiJobRetries", fields: [retryOfJobId], references: [id], onDelete: SetNull)
  retries      AiJob[] @relation("AiJobRetries")

  bullJobId     String? @unique @db.VarChar(120)
  maxRounds     Int     @default(2)
  currentRound  Int     @default(0)
  inputPayload  Json?
  finalOutput   Json?
  finalProvider AiProvider?
  finalModel    String? @db.VarChar(180)
  errorSummary  String? @db.Text

  queuedAt    DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  failedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts        AiAttempt[]
  retrievedChunks AiJobKnowledgeChunk[]

  @@index([status, createdAt])
  @@index([incidentId, createdAt])
  @@index([retryOfJobId])
  @@map("ai_jobs")
}

model AiAttempt {
  id       String          @id @default(uuid(7)) @db.Uuid
  jobId    String          @db.Uuid
  job      AiJob           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  round    Int
  sequence Int
  provider AiProvider
  model    String          @db.VarChar(180)
  status   AiAttemptStatus @default(PENDING)

  requestPayload   Json?
  rawResponse      Json?
  parsedResponse   Json?
  errorCode        String? @db.VarChar(100)
  errorMessage     String? @db.Text
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  latencyMs        Int?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@unique([jobId, round, sequence])
  @@index([jobId, createdAt])
  @@index([provider, status, createdAt])
  @@map("ai_attempts")
}

model KnowledgeDocument {
  id            String                  @id @default(uuid(7)) @db.Uuid
  title         String                  @db.VarChar(250)
  sourceType    KnowledgeSourceType
  sourceUrl     String?                 @db.Text
  storageBucket String?                 @db.VarChar(100)
  storageKey    String?                 @db.Text
  checksum      String?                 @db.VarChar(128)
  version       Int                     @default(1)
  status        KnowledgeDocumentStatus @default(DRAFT)
  metadata      Json?

  createdById   String? @db.Uuid
  createdBy     User?   @relation("KnowledgeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedById String? @db.Uuid
  publishedBy   User?   @relation("KnowledgePublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chunks KnowledgeChunk[]

  @@index([status, sourceType])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id         String            @id @default(uuid(7)) @db.Uuid
  documentId String            @db.Uuid
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex Int
  content    String            @db.Text
  tokenCount Int?
  metadata   Json?

  embeddingProvider AiProvider @default(OPENROUTER)
  embeddingModel    String     @db.VarChar(180)

  // pgvector. Al elegir el modelo final, cambia a vector(N)
  // mediante SQL, donde N sea la dimensión exacta de ese modelo.
  embedding Unsupported("vector")?

  embeddedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  aiJobs AiJobKnowledgeChunk[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@index([embeddingModel])
  @@map("knowledge_chunks")
}

model AiJobKnowledgeChunk {
  jobId      String         @db.Uuid
  job        AiJob          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  chunkId    String         @db.Uuid
  chunk      KnowledgeChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)
  rank       Int
  similarity Decimal?       @db.Decimal(7, 6)
  createdAt  DateTime       @default(now())

  @@id([jobId, chunkId])
  @@index([jobId, rank])
  @@map("ai_job_knowledge_chunks")
}

model Notification {
  id        String             @id @default(uuid(7)) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  status    NotificationStatus @default(PENDING)
  title     String             @db.VarChar(180)
  body      String             @db.Text
  data      Json?
  sentAt    DateTime?
  readAt    DateTime?
  error     String?            @db.Text
  createdAt DateTime           @default(now())

  @@index([userId, status, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   @db.VarChar(120)
  entityType String   @db.VarChar(80)
  entityId   String?  @db.VarChar(120)
  oldValue   Json?
  newValue   Json?
  ipAddress  String?  @db.VarChar(64)
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}
